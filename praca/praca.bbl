      \field{journaltitle}{Applied Sciences (Basel, Switzerland)}
      \field{month}{10}
      \field{number}{10}
      \field{title}{Visualization and {Interpretation} of {Convolutional} {Neural} {Network} {Predictions} in {Detecting} {Pneumonia} in {Pediatric} {Chest} {Radiographs}}
