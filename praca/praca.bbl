      \field{title}{Assessment of {Remote} {Heart} {Rhythm} {Sampling} {Using} the {AliveCor} {Heart} {Monitor} to {Screen} for {Atrial} {Fibrillation}: {The} {REHEARSE}-{AF} {Study}}
